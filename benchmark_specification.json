  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates local and remote numa_sweep latency. On one node, remote may equal local"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Build src/numa_sweep.cpp and run a random pointer chase on yaml local and remote NUMA targets for each working_set_size, optionally wrapping with perf stat -e cache-misses, to measure local vs remote latency. The overlay CSV also has ratio, bandwidth, and miss-rate columns; the harness raw file keeps local/remote latency plus parameters"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Build src/numa_sweep.cpp and run a random pointer chase on yaml local and remote NUMA targets for each working_set_size, optionally under perf stat -e cache-misses. Record local versus remote latency. The overlay also keeps ratio, bandwidth, and miss rate; the harness raw file keeps local and remote latency plus the sweep parameters"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Builds bin/numa_sweep and walks yaml source versus target NUMA nodes for each working_set_size. source_numa_node, target_numa_node, num_threads, page_size, stride, access_pattern, cache_level, and num_iterations come from yaml. Optional perf stat -e cache-misses may be attached. The harness raw file keeps local/remote latency columns; overlay also has ratio, bandwidth, and miss-rate fields"
  },
